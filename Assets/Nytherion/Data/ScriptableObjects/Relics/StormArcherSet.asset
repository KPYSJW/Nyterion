  description_KR: "\uC6D0\uAC70\uB9AC \uACF5\uACA9 \uC18D\uB3C4\uB97C \uB192\uC774\uACE0,
    \uCE58\uBA85\uD0C0 \uC801\uC911 \uC2DC \uC5F0\uC1C4 \uBC88\uAC1C\uC640 \uC77C\uC815
