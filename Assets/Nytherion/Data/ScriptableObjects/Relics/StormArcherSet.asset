  description_EN: Increase ranged attack speed, trigger chain lightning on critical
    hits, and fire an extra projectile periodically.
  synergySeriesId: StormArcherSeries
  bonusModules:
  - description_KR: "\uC6D0\uAC70\uB9AC \uACF5\uACA9 \uC18D\uB3C4 +8%"
