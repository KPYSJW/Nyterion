  setName_KR: "난반사"
  setName_EN: "Ricochet"
  statusIcon: {fileID: 21300000, guid: 13de074211234cd9bd28cffabdc548a6, type: 3}
  badgeBackgroundColor: {r: 0.12, g: 0.38, b: 0.42, a: 0.96}
  badgeTextColor: {r: 0.86, g: 1, b: 0.96, a: 1}
  description_KR: "도탄 피해 감소를 완화하고 도탄 투사체를 강화합니다."
  description_EN: "Reduce ricochet damage loss and enhance bouncing projectiles."
  synergySeriesId: TrickshotEngineerSeries
  bonusModules:
  - condition: {rid: 3001}
    effects:
    - rid: 3002
    description_KR: "첫 도탄 피해 감소 25%, 이후 도탄 피해 감소 10%"
    description_EN: First ricochet loses 25% damage; later ricochets lose 10%
  - condition: {rid: 5001}
    effects:
    - rid: 5002
    description_KR: "도탄 피해 감소 없음. 도탄할 때마다 속도 10% 증가"
    description_EN: Ricochets no longer lose damage and gain 10% speed per bounce.
  - condition: {rid: 7001}
    effects:
    - rid: 7002
    description_KR: "도탄할 때마다 속도와 피해 10% 증가. 충돌 시 피해 35%의 추가 탄환 2발 발사(도탄 불가)"
    description_EN: Ricochets gain 10% speed and damage per bounce. Collisions fire 2 extra shots at 35% damage; extra shots cannot ricochet.
